# 前端环境变量模板（本地开发通过 Vite proxy 转发 /api，留空即可）
VITE_API_BASE_URL=
VITE_SENTRY_DSN=

# PostgreSQL 配置
POSTGRES_USER=sceneflow
POSTGRES_PASSWORD=sceneflow_dev
POSTGRES_DB=sceneflow
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://sceneflow:sceneflow_dev@127.0.0.1:5432/sceneflow

# MinIO 对象存储配置
MINIO_ENDPOINT=http://127.0.0.1:9000
MINIO_PUBLIC_URL=http://127.0.0.1:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
MINIO_BUCKET=media

# JWT 鉴权密钥（生产环境务必替换为随机长字符串）
JWT_SECRET=change-me-in-production
JWT_EXPIRE_MINUTES=10080

# AI 对话服务（OpenAI 兼容协议）
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_VISION_MODEL=gpt-4o-mini

# 图像理解服务（未单独配置时复用 LLM 视觉模型）
VISION_BASE_URL=
VISION_API_KEY=
VISION_MODEL=

# 场景生图服务（openai 复用 /v1/images/edits；kling 需单独配置可灵端点）
IMG_GEN_PROVIDER=openai
IMG_GEN_BASE_URL=
IMG_GEN_API_KEY=
IMG_GEN_MODEL=gpt-image-2.6
